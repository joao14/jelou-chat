  "x-jelou-config-derived": {
    "condition": {
      "configPath": "configuration.conditions[].id",
      "edgeBranch": "condition:<id>",
      "note": "Each condition.id needs a condition:<id> edge plus a sibling else edge; wire is success-<id>.",
      "sourceTypes": [
        "CONDITIONAL"
      ]
    },
    "option": {
      "configPath": "configuration.messages[].options[].id",
      "edgeBranch": "option:<id>",
      "note": "Each interactive option.id needs an outbound option:<id> edge; wire handle is the bare id.",
      "sourceTypes": [
        "CHANNEL_MESSAGE",
        "MESSAGE"
      ]
    },
    "output": {
      "configPath": "(TOOL: the callee's declared output ids, from `jelou tool show <slug|id>`) | configuration.nativeOutputs[].id | configuration.output[].id | (SKILL: the called workflow's outputs[].id)",
      "edgeBranch": "output:<id>:success | output:<id>:failed | output:<id>:default",
      "note": "Named output ports: TOOL keys on the output ids the callee declares (never toolData.toolName), MCP on nativeOutputs[].id, SKILL_MARKETPLACE on output[].id, SKILL on the called workflow's outputs[].id; wire is success-<id>:<sourceId> / source-error-<id>:<sourceId> / source-default-<id>:<sourceId> (neutral outputs).",
      "sourceTypes": [
        "TOOL",
        "MCP",
        "SKILL_MARKETPLACE",
        "SKILL"
      ]
    },
    "route": {
      "configPath": "configuration.routes[].id",
      "edgeBranch": "route:<id>",
      "note": "Each route.id needs a route:<id> edge; wire handle is the bare id (default type).",
      "sourceTypes": [
        "RANDOM"
      ]
    }
  },
