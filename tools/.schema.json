{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jelou.ai/schemas/tool.schema.json",
  "title": "Jelou Tool",
  "type": "object",
  "properties": {
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "branch": {
            "type": "string"
          },
          "configuration": {
            "type": "object",
            "additionalProperties": true
          },
          "id": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "targetId": {
            "type": "string"
          }
        },
        "required": [
          "sourceId",
          "targetId"
        ],
        "additionalProperties": true
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "configuration": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "defaultValue": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "position": {
            "type": "number"
          },
          "required": {
            "type": "boolean"
          },
          "type": {
            "enum": [
              "STRING",
              "BOOLEAN",
              "NUMBER",
              "OBJECT",
              "ARRAY",
              "ENUM",
              "DATUM"
            ]
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": true
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "configuration": {
            "type": "object",
            "additionalProperties": true
          },
          "id": {
            "type": "string"
          },
          "position": {},
          "title": {
            "type": "string"
          },
          "type": {
            "enum": [
              "AI_LOGIC",
              "AI_TASK",
              "BILLING",
              "CHANNEL_MESSAGE",
              "CHECKPOINT",
              "CODE",
              "CONDITIONAL",
              "CONNECT",
              "DATUM",
              "DATUM_MARKETPLACE",
              "ECOMMERCE",
              "EMPTY",
              "END",
              "EXTERNAL_AGENT",
              "FLOW",
              "GENESYS",
              "HSM",
              "HTTP",
              "HUBSPOT",
              "IF",
              "IF_ERROR",
              "INPUT",
              "MCP",
              "MEMORY",
              "NOTE",
              "PAUSE",
              "PAYMENT",
              "PMA",
              "RANDOM",
              "SKILL",
              "SKILL_MARKETPLACE",
              "SOAP",
              "START",
              "TOOL",
              "WEBHOOK"
            ]
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "AI_LOGIC"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "required": [
                    "instructions",
                    "model",
                    "variable"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "AI_TASK"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "required": [
                    "connections",
                    "endFunction",
                    "fallbackModel",
                    "filesConfig",
                    "instructions",
                    "knowledge",
                    "model",
                    "nodeType",
                    "settings",
                    "variable",
                    "version"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "CHANNEL_MESSAGE"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "required": [
                    "messages"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "CODE"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "required": [
                    "content",
                    "memoryVersion"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "CONDITIONAL"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "required": [
                    "conditions"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "CONNECT"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "required": [
                    "assignment"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "DATUM"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "required": [
                    "action",
                    "databaseId"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "END"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "required": [
                    "outputId"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "HSM"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "required": [
                    "destinations",
                    "elementName"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "HTTP"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "required": [
                    "url"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "INPUT"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "required": [
                    "prompt",
                    "variable"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "MCP"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "required": [
                    "app",
                    "selectedToolId",
                    "toolType"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "MEMORY"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "required": [
                    "variables"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "PAUSE"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "required": [
                    "duration",
                    "time"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "RANDOM"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "required": [
                    "routes"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "SKILL"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "required": [
                    "skillId"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "SKILL_MARKETPLACE"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "required": [
                    "skill"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "SOAP"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "required": [
                    "functionName",
                    "url"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "TOOL"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "required": [
                    "toolData",
                    "version"
                  ],
                  "additionalProperties": true
                }
              }
            }
          }
        ]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "position": {
            "type": "number"
          },
          "required": {
            "type": "boolean"
          },
          "schema": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "type": {
            "enum": [
              "SUCCESS",
              "FAILED"
            ]
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": true
      }
    },
    "ownership": {
      "enum": [
        "OWNED",
        "FORKED",
        "PURCHASED"
      ]
    },
    "toolDescription": {
      "type": "string"
    },
    "toolId": {
      "type": "number"
    },
    "toolName": {
      "type": "string"
    },
    "triggerType": {
      "enum": [
        "DEFAULT",
        "WEBHOOK",
        "SCHEDULER"
      ]
    },
    "workflowId": {
      "type": "number"
    }
  },
  "required": [
    "toolId",
    "workflowId",
    "toolName",
    "inputs",
    "outputs",
    "nodes",
    "edges"
  ],
  "additionalProperties": true,
  "x-jelou-branches": {
